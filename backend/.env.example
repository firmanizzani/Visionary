DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/visionary?sslmode=require
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
FRONTEND_URL=http://127.0.0.1:5173
# Local HTTP also accepts localhost at this same port when COOKIE_SECURE=false.
# Vercel: set FRONTEND_URL to the actual frontend HTTPS origin and COOKIE_SECURE=true.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
CRON_SECRET=replace-with-a-random-scheduler-secret
