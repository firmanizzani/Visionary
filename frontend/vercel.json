{
  "headers": [
    {
      "source": "/models/(.*).onnx",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/octet-stream"
        },
        {
          "key": "Cache-Control",
          "value": "public,max-age=86400"
        }
      ]
    },
    {
      "source": "/models/(.*).bin",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/octet-stream"
        },
        {
          "key": "Cache-Control",
          "value": "public,max-age=86400"
        }
      ]
    }
  ],
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "sveltekit",
  "installCommand": "npm ci",
  "buildCommand": "npm run build"
}
